# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production
# Worker RUNTIME secrets for `wrangler dev` (see .dev.vars.example). Never
# versioned; the deployed Workers hold these as secrets instead.
.dev.vars

# wrangler local cache (Cloudflare adapter)
.wrangler/

# generated artifacts
tmp/
# `sanity schema extract` output, regenerated by `npm run typegen`. Moved up
# from studio/schema.json on 2026-09-06 when the nested studio package was
# folded into this one (PORTS.md card 10).
/schema.json
# Standalone `npx sanity build .studio-dist` output. There is deliberately no
# studio:build script: the Studio is built by `astro build` now, and plain
# `sanity build` writes to ./dist, which would clobber the Astro build.
.studio-dist/
# Sanity CLI local state
.sanity/

# Sanity asset-id cache written by scripts/lib/sanity-lib.mjs (2026-08-27).
# Machine-local: it maps a repo-relative file path to the asset _id that upload
# produced, so a re-run of a seed never re-uploads. Never versioned.
scripts/.asset-map.json

# transient commit message files
.git-commit-msg.tmp

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Local Sanity dataset backups (not versioned)
backups/

# Playwright output (family test standard)
playwright-report/
test-results/
.lighthouseci/
