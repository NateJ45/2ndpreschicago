{
  "name": "secondpreschicago",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/free-dist.mjs",
    "build": "astro build",
    "free-dist": "node scripts/free-dist.mjs",
    "parity": "node scripts/page-parity.mjs",
    "sync-check": "node scripts/sync-check.mjs",
    "build:full": "npm run typegen && astro build",
    "preview": "wrangler dev -c dist/server/wrangler.json",
    "astro": "astro",
    "deploy": "npm run build && wrangler deploy -c dist/server/wrangler.json",
    "generate-types": "wrangler types",
    "typegen": "sanity schema extract --force && sanity typegen generate",
    "og": "node scripts/generate-og-default.mjs",
    "og:pages": "node scripts/generate-og-pages.mjs",
    "llms:full": "node scripts/generate-llms-full.mjs",
    "studio:import": "node scripts/import-content.mjs",
    "seed": "node scripts/seed-core.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "node --experimental-strip-types --test src/lib/*.test.ts",
    "check": "astro check && npm run lint",
    "check:full": "npm run typegen && npm run build && npm run test:unit",
    "lint": "eslint src scripts tests playwright.config.ts sanity.config.ts sanity.cli.ts",
    "lint:fix": "eslint --fix src scripts tests playwright.config.ts sanity.config.ts sanity.cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve:dist": "http-server dist/client -p 4321 -s -c-1 --silent",
    "check:links": "linkinator ./dist/client --recurse --skip \"^https?://(?!(localhost|127[.]0[.]0[.]1)[:/])\" --skip \"client\\W(studio|preview|api)(\\W|$)\"",
    "studio:dev": "sanity dev"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/react": "^6.0.5",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@portabletext/react": "^8.0.1",
    "@portabletext/types": "^4.0.2",
    "@sanity/astro": "3.5.1",
    "@sanity/client": "8.5.0",
    "@sanity/icons": "3.8.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/preview-url-secret": "4.1.5",
    "@sanity/ui": "4.0.7",
    "@sanity/vision": "6.12.0",
    "@sanity/visual-editing": "6.1.2",
    "@tabler/icons-react": "^3.46.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "astro": "^7.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.40.0",
    "motion": "^12.40.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "19.2.8",
    "react-photo-album": "^3.6.1",
    "sanity": "6.12.0",
    "sanity-plugin-asset-source-unsplash": "7.0.25",
    "sanity-plugin-media": "6.1.8",
    "shadcn": "^4.20.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "styled-components": "6.5.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "wrangler": "^4.95.0",
    "yet-another-react-lightbox": "^3.32.2"
  },
  "overrides": {
    "@sanity/visual-editing": "6.1.2",
    "@sanity/client": "8.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "5.20260903.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "http-server": "^14.1.1",
    "linkinator": "^8.1.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.0",
    "typescript-eslint": "^8.69.0"
  }
}
