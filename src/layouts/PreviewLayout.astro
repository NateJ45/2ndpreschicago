---
/* ============================================================================
   PreviewLayout - Studio-only shell for /preview/* pages
   (ported from mas-monograms 2026-09-06, PORTS.md cards 10 and 11; original
   lineage: ncs-astro-sanity-starter and the WCP site)
   ============================================================================
   Deliberately NOT BaseLayout: it skips analytics, canonical/OG tags, Lenis,
   the announcement banner and the JSON-LD, none of which belong on a draft
   page that only the Presentation Tool's iframe ever loads. `noindex, nofollow`
   is non-negotiable here: these pages must never appear in search results.

   Renders the REAL Header and Footer around the page body so the preview
   matches production edge to edge. That is only safe because the click
   interceptor at the bottom of this file exists: without it a header link
   bounces the iframe onto the live site and the Studio silently freezes.
   Each piece is wrapped in a `data-sanity` attribute pointed at `siteSettings`
   (the WordPress-template-part gesture): in Edit mode the chrome outlines as an
   editable surface and a click opens Site settings in the edit panel.

   UNLIKE the rest of the family, this site HAS a dark theme, so the anti-FOUC
   theme bootstrap comes across from BaseLayout. Without it the preview always
   renders light while the editor's Studio and site are dark, which reads as a
   broken preview rather than a missing script.
   ============================================================================ */
import '@/styles/globals.css';
import VisualEditingOverlay from '@/components/preview/VisualEditingOverlay.tsx';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/data/site';
import { previewFetch } from '@/lib/cms-preview';
import { docEditAttr } from '@/lib/preview-edit-attr';
import { SITE_SETTINGS_PROJECTION } from '@/lib/queries';

interface Props {
  title: string;
  draftMode: boolean;
  /** Doc id this preview renders (e.g. "homePage"). */
  pageId: string;
}
const { title, draftMode, pageId } = Astro.props;

// ---------------------------------------------------------------------------
// THE SOFT-REFRESH RENDER IS A CHEAPER RENDER
// ---------------------------------------------------------------------------
// The overlay's reconcile refetch sends `x-preview-soft-refresh: 1` and then
// consumes exactly one thing from the response: `#main`. Everything this shell
// draws AROUND <main> - the header and the footer - is parsed and thrown away.
// That cost a Sanity round trip on a route a burst of edits runs repeatedly.
//
// So on a soft refresh that fetch is skipped. This is safe in the narrow,
// checkable sense that matters: NOTHING inside `#main` reads the value.
// `chromeSettings` feeds only Header and Footer, both of which are siblings of
// <main> in the body below, and the page body's own content comes from the
// route's separate fetch in src/pages/preview/[...slug].astro, which is
// untouched. The `#main` HTML is therefore byte-for-byte what a full render
// produces - which is the only thing the reconcile can see.
//
// The chrome still renders, from its null fallbacks, so this response is a
// valid page rather than a fragment. Nobody looks at it: it is only ever sent
// by the refetch in VisualEditingOverlay.tsx, never by a navigation.
const softRefresh = Astro.request.headers.get('x-preview-soft-refresh') === '1';

// Draft-aware settings for the chrome, so header/footer edits live-update in
// the preview. Null-safe: Header and Footer render their fallbacks cleanly.
// Runs the SAME projection the live site runs (SITE_SETTINGS_PROJECTION), so
// the preview's menus cannot drift from production's.
const chromeSettings = softRefresh
  ? null
  : await previewFetch<any>(
      draftMode,
      `*[_type == "siteSettings"][0]${SITE_SETTINGS_PROJECTION}`,
    ).catch(() => null);

// Header opens the doc at its identity, footer at the tagline, so each click
// lands the editor near what that piece of chrome shows.
const headerAttr = docEditAttr('siteSettings', 'siteSettings', 'title');
const footerAttr = docEditAttr('siteSettings', 'siteSettings', 'tagline');
---

<!doctype html>
<html lang="en" data-draft={draftMode ? '1' : '0'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    {
      /* Anti-FOUC theme bootstrap, the same one BaseLayout runs. Reduced to the
        class + colorScheme half: the theme-aware <img> swap in BaseLayout is for
        the logo images, and this site's header wordmark is text. */
    }
    <script is:inline define:vars={{ key: site.themeStorageKey }}>
      (function () {
        try {
          const stored = localStorage.getItem(key) ?? 'system';
          const dark =
            stored === 'dark' ||
            (stored === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        } catch (_) {
          /* localStorage unavailable, default light */
        }
      })();
    </script>
    <script is:inline>
      // Before paint: mark whether this preview page is EMBEDDED in the Studio's
      // Presentation iframe. Two behaviors hang off the class:
      //  - The "Exit preview" button hides when embedded. Inside Presentation it
      //    is a trap: it clears the draft cookie and strands the iframe on the
      //    live site with no Studio connection, and nothing short of reloading
      //    the whole Studio re-runs the enable handshake. The way out of
      //    Presentation is Presentation's own chrome.
      //  - The slim bar shows a reconnect hint if a page ever renders embedded
      //    but WITHOUT draft mode (a dead session), instead of failing silently.
      if (window.self !== window.top) {
        document.documentElement.classList.add('in-studio-frame');
        if (document.documentElement.dataset.draft !== '1') {
          document.documentElement.classList.add('preview-disconnected');
        }
      }
    </script>
    <style>
      .in-studio-frame [data-exit-preview] {
        display: none;
      }
      [data-reconnect-hint] {
        display: none;
      }
      .in-studio-frame.preview-disconnected [data-reconnect-hint] {
        display: inline;
      }
      .in-studio-frame.preview-disconnected [data-connected-note] {
        display: none;
      }
    </style>
  </head>
  <body class="relative bg-background text-foreground">
    <div
      class="flex items-center justify-between gap-4 border-b border-border bg-card px-4 py-1.5 text-xs text-foreground/70"
    >
      <span data-connected-note
        >Draft preview. Click the header or footer to edit Site settings.</span
      >
      <span data-reconnect-hint class="font-semibold"
        >Draft session ended. Reload the Studio browser tab to reconnect the preview.</span
      >
    </div>
    {
      /* The real site chrome, draft-aware, each piece an editable surface. The
        wrapper divs are REAL block boxes on purpose: the overlay outlines the
        element's rect. */
    }
    <div data-sanity={headerAttr}>
      <Header siteSettings={chromeSettings} />
    </div>
    <main id="main"><slot /></main>
    <div data-sanity={footerAttr}>
      <Footer siteSettings={chromeSettings} />
    </div>

    {
      /* The motion system's END states, forced. BaseLayout's IntersectionObserver
        script is not loaded here (this shell is deliberately minimal), and the
        reveal vocabulary hides content until it runs, so without this block the
        preview would render INVISIBLE sections. Keep it in step with the motion
        vocabulary in src/styles/globals.css. */
    }
    <style is:global>
      [data-reveal],
      .img-curtain {
        opacity: 1 !important;
        translate: 0 0 !important;
      }
      .img-curtain::after {
        display: none !important;
      }
    </style>

    {
      draftMode && (
        <>
          <VisualEditingOverlay client:only="react" pageId={pageId} />
          <a
            href="/api/draft-mode/disable"
            data-exit-preview
            class="fixed right-4 bottom-4 z-50 rounded-full bg-primary px-4 py-2 text-sm font-bold text-primary-foreground shadow-lg"
          >
            Exit preview
          </a>
        </>
      )
    }

    <script>
      // =======================================================================
      // Keep clicks INSIDE the preview surface (PORTS.md card 11)
      // =======================================================================
      // Page bodies are full of real-site links (/worship, /give, the Plan a
      // visit CTA). Left alone, clicking one navigates the Presentation iframe
      // to the LIVE page, which has no Studio connection: the URL bar, the page
      // navigator and the edit panel all silently freeze on the previous page
      // while the iframe shows the real site, chrome and all. An editor reported
      // exactly this against a production site in the family.
      //
      // So: same-origin links with a preview equivalent are remapped into
      // /preview/* (the visual-editing history adapter then reports the new
      // location, and Presentation resolves the document, so the navigator and
      // the edit panel follow the click). Links with NO preview route (the
      // per-sermon and per-event detail pages, /api, /studio, external origins)
      // split by context:
      //  - EMBEDDED in the Studio: the navigation is SUPPRESSED entirely. A click
      //    on a card there is an EDIT gesture (the stega overlay already selects
      //    the right field and document), and a live tab popping open on every
      //    card click forces a tab-switch back to the Studio each time.
      //  - Standalone /preview tab: NEW TAB, so the preview surface is never
      //    hijacked.
      //
      // THE ROUTE MAP IS PER-SITE. This set is the THIRD copy of the same map and
      // the one that degrades SILENTLY when it falls out of step (a missed entry
      // does not error, it just lets a click escape to the live site). The other
      // two are PREVIEW_PAGES in src/pages/preview/[...slug].astro and
      // SINGLETON_PREVIEW_PATHS in src/sanity/resolve.ts. Change one, change all
      // three.
      const FIRST_SEGMENT_PREVIEWABLE = new Set([
        'about',
        'worship',
        'what-we-believe',
        'music',
        'pastor-staff',
        'grow',
        'serve',
        'kids',
        'food',
        'use-our-space',
        'weddings',
        'give',
        'events',
        'sermons',
        'faq',
        'contact',
        'privacy',
        '404',
      ]);

      document.addEventListener(
        'click',
        (event) => {
          if (event.defaultPrevented || event.button !== 0) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          const anchor = (event.target as Element | null)?.closest?.('a[href]');
          if (!(anchor instanceof HTMLAnchorElement)) return;
          if (anchor.target === '_blank' || anchor.hasAttribute('download')) return;

          const embedded = document.documentElement.classList.contains('in-studio-frame');
          // EDIT MODE: while Presentation's Edit toggle is ON, the visual-editing
          // overlay keeps its outline boxes ([data-sanity-overlay-element]) in
          // the DOM. In that mode EVERY click is a selection gesture - buttons
          // with preview equivalents included - so suppress ALL navigation and
          // let the overlay's selection be the whole result. With Edit toggled
          // OFF the boxes are gone and clicks browse normally (remap below).
          if (embedded && document.querySelector('[data-sanity-overlay-element]')) {
            event.preventDefault();
            return;
          }
          const url = new URL(anchor.href, window.location.href);
          // External origin: never let it take over the iframe.
          if (url.origin !== window.location.origin) {
            event.preventDefault();
            if (!embedded) window.open(url.href, '_blank', 'noopener');
            return;
          }
          const path = url.pathname.replace(/\/+$/, '') || '/';
          // Already a preview path, an API call, or a same-page hash: default.
          const first = path === '/' ? '' : path.split('/')[1];
          if (path.startsWith('/preview') || first === 'api') return;
          if (path === window.location.pathname && url.hash) return;

          const segments = path === '/' ? [] : path.slice(1).split('/');
          const previewable =
            path === '/' || (segments.length === 1 && FIRST_SEGMENT_PREVIEWABLE.has(first));

          event.preventDefault();
          if (previewable) {
            window.location.assign(path === '/' ? '/preview' : `/preview${path}`);
          } else if (!embedded) {
            // Standalone tab: routes without a preview open in a new tab.
            window.open(url.href, '_blank', 'noopener');
          }
          // Embedded: suppressed. The stega overlay's field selection IS the
          // click's result; the editor stays in the Studio.
        },
        true,
      );
    </script>
  </body>
</html>
