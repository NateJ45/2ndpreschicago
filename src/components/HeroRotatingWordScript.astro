---
// Foundation, edit with care
// Rotating-word cycler for the hero headline. Rendered by Hero.astro when the
// editor supplied two or more rotating words. Runs once per session (the
// sessionStorage flag) and never under prefers-reduced-motion.
//
// Lives in its own component because prettier-plugin-astro cannot parse a
// <script> nested inside a template expression ({cond && (<script>...)}):
// it reads the script body's braces as expression delimiters. Rendering the
// script from a component under the same condition keeps the built markup
// identical and lets the parent file be formatted.
---

<script is:inline>
  (function () {
    try {
      if (sessionStorage.getItem('hero-word-rotated') === '1') return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    } catch (_) {
      /* ignore */
    }

    function init() {
      const el = document.querySelector('[data-rotating-word]');
      if (!el || el.dataset.rotated === '1') return;
      el.dataset.rotated = '1';
      let words;
      try {
        words = JSON.parse(el.dataset.rotatingWords || '[]');
      } catch (_) {
        return;
      }
      if (!Array.isArray(words) || words.length < 2) return;

      const original = words[0];
      const intervalMs = 850;
      // words.length ticks lands us on the original at the final cycle
      // because words[length % length] === words[0] === original. The
      // earlier `length + 1` produced one redundant tick that flashed the
      // original word twice in a row at the end of the sequence.
      const totalCycles = words.length;
      let count = 0;

      const id = setInterval(() => {
        count += 1;
        const target = count >= totalCycles ? original : words[count % words.length];
        el.style.transition = 'opacity 200ms ease-out';
        el.style.opacity = '0';
        setTimeout(() => {
          el.textContent = target;
          el.style.opacity = '1';
        }, 200);

        if (count >= totalCycles) {
          clearInterval(id);
          try {
            sessionStorage.setItem('hero-word-rotated', '1');
          } catch (_) {}
        }
      }, intervalMs);
    }
    init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
