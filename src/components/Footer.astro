---
// Foundation, edit with care
// Site footer, rebuilt for a church on the deep Chapel-green brand surface
// (the cool liturgical counterpoint to the warm page). Distinct from the base
// template's light single-strip footer.
//
// Structure (top to bottom):
//   1. Bronze accent stripe (brand signature, matches header utility bar)
//   2. Optional newsletter signup (only when siteSettings.newsletter.enabled)
//   3. Brand + mission + Plan a Visit  |  Sunday Worship card (times, address,
//      Get directions) — the church "front door" summary
//   4. Four-column link grid: Visit / Get Involved / Connect / Get in touch
//   5. Thin bottom bar: auto-year copyright, privacy link, optional credit
//
// STRUCTURE: do not edit layout/markup here to change wording. Editor-facing
// copy (service times, mission, contact, social, giving link) flows in through
// Sanity siteSettings, falling back to src/data/site.ts so real info shows
// before Sanity is wired.
//
// Tailwind v4 gotcha: max-w-xs/s/m/l are shadowed by this project's custom
// --spacing-* tokens. Use max-w-md / max-w-2xl / arbitrary values for text widths.

import { resolveSiteSettings } from '@/lib/siteSettings';
import { IconBrandInstagram, IconBrandFacebook, IconBrandYoutube } from '@tabler/icons-react';
import { Phone, MapPin, Mail, Clock } from 'lucide-react';
import NewsletterSignup from '@/components/NewsletterSignup';
import { telHref } from '@/lib/phone';
import { serviceTime } from '@/lib/serviceTime';

interface NewsletterConfig {
  enabled?: boolean;
  heading?: string;
  blurb?: string;
  buttonLabel?: string;
  successMessage?: string;
  consentNote?: string;
  formActionUrl?: string | null;
  audienceId?: string | null;
}

interface Props {
  siteSettings?: {
    title?: string;
    email?: string;
    phone?: string;
    addressLine?: string;
    cityStateZip?: string;
    socialInstagram?: string;
    socialFacebook?: string;
    socialYoutube?: string;
    tagline?: string;
    mission?: string;
    worshipService?: {
      time?: string;
      day?: string;
      startTime24?: string;
      endTime24?: string;
    } | null;
    giveUrl?: string;
    appUrl?: string;
    directoryUrl?: string;
    prayerUrl?: string;
    footerCredit?: string;
    footerCreditUrl?: string;
    newsletter?: NewsletterConfig | null;
    // Editor-managed footer link columns (Site Settings -> Navigation). When
    // empty, the built-in columns below render.
    footerColumns?: Array<{
      title?: string;
      links?: Array<{ label?: string; href?: string }>;
    }> | null;
  } | null;
}

const { siteSettings } = Astro.props as Props;

// Every identity / contact / social value resolves through one shared helper
// (see src/lib/siteSettings.ts) so the footer can't drift from the header, the
// pages, or the JSON-LD. Empty Sanity fields render blank (or hide) rather than
// showing a hardcoded stand-in.
const settings = resolveSiteSettings(siteSettings);
const brandName = settings.brandName;
const email = settings.email;
const phone = settings.phone;
const officeHours = settings.officeHours; // undefined when unset -> line hides
const ig = settings.social.instagram;
const fb = settings.social.facebook;
const yt = settings.social.youtube;
const tagline = settings.tagline;
const mission = settings.mission;
const serviceTimes = serviceTime(settings.worshipService).line;
const giveHref = settings.giveHref;
const addressLine = settings.addressLine;
const cityStateZip = settings.cityStateZip;
const fullAddress = settings.fullAddress;
const mapHref = settings.mapHref;

const currentYear = new Date().getFullYear();
const siteCredit = siteSettings?.footerCredit;
const siteCreditUrl = siteSettings?.footerCreditUrl;

// STRUCTURE: footer navigation, grouped to mirror the header IA.
const VISIT_LINKS = [
  { label: 'Plan a Visit', href: '/worship' },
  { label: 'Watch Sermons', href: '/sermons' },
  { label: 'What We Believe', href: '/what-we-believe' },
  { label: 'Music', href: '/music' },
  { label: 'Events', href: '/events' },
];
const INVOLVED_LINKS = [
  { label: 'Grow', href: '/grow' },
  { label: 'Serve', href: '/serve' },
  { label: 'Kids', href: '/kids' },
  { label: 'Food Ministry', href: '/food' },
];
const CONNECT_LINKS = [
  { label: 'Pastors & Staff', href: '/pastor-staff' },
  { label: 'Use Our Space', href: '/use-our-space' },
  { label: 'Weddings', href: '/weddings' },
  { label: 'Contact', href: '/contact' },
  { label: 'Give', href: '/give' },
];

// Optional external integrations (church app, member directory, prayer card).
// Appended to the Connect column only when set in siteSettings, so the template
// can point at Subsplash / Planning Center / etc. without code, and nothing
// extra shows for a church (like Second) that doesn't use them.
const connectLinks = [
  ...CONNECT_LINKS,
  ...(siteSettings?.appUrl
    ? [{ label: 'Church App', href: siteSettings.appUrl, external: true }]
    : []),
  ...(siteSettings?.directoryUrl
    ? [{ label: 'Member Directory', href: siteSettings.directoryUrl, external: true }]
    : []),
  ...(siteSettings?.prayerUrl
    ? [{ label: 'Prayer Request', href: siteSettings.prayerUrl, external: true }]
    : []),
];

// Footer link columns. Editors can override these in Site Settings -> Navigation
// (Footer link columns). When unset, the built-in columns render, with the
// optional app/directory/prayer integrations appended to Connect. The separate
// "Get in touch" column (contact + social) always renders and is not configured
// here. External links open in a new tab.
type FooterColumn = { title: string; links: { label: string; href: string; external?: boolean }[] };

const FALLBACK_FOOTER_COLUMNS: FooterColumn[] = [
  { title: 'Visit', links: VISIT_LINKS },
  { title: 'Get Involved', links: INVOLVED_LINKS },
  { title: 'Connect', links: connectLinks },
];

function footerColumnsFromSettings(
  cols?: Array<{ title?: string; links?: Array<{ label?: string; href?: string }> }> | null,
): FooterColumn[] | null {
  if (!Array.isArray(cols) || cols.length === 0) return null;
  const mapped: FooterColumn[] = [];
  for (const c of cols) {
    const links = (Array.isArray(c?.links) ? c.links : [])
      .filter((l) => l?.label && l?.href)
      .map((l) => ({ label: l.label as string, href: l.href as string }));
    if (c?.title && links.length > 0) mapped.push({ title: c.title, links });
  }
  return mapped.length > 0 ? mapped : null;
}

const FOOTER_COLUMNS: FooterColumn[] =
  footerColumnsFromSettings(siteSettings?.footerColumns) ?? FALLBACK_FOOTER_COLUMNS;

// Shared link class for the footer columns (cream on green, animated underline).
const footerLink =
  'link-underline inline-block text-chapel-foreground/80 hover:text-white transition-colors';
---

<footer class="bg-chapel-deep text-chapel-foreground">
  {/* Brand accent stripe — matches the header utility bar + mobile drawer. */}
  <div class="h-1 bg-primary" aria-hidden="true"></div>

  {/* Newsletter signup — renders only when siteSettings.newsletter.enabled. */}
  {
    siteSettings?.newsletter?.enabled && (
      <div class="mx-auto max-w-content px-m pt-l">
        <div class="mx-auto max-w-md">
          <NewsletterSignup client:visible newsletter={siteSettings.newsletter} source="footer" />
        </div>
      </div>
    )
  }

  {/* ---- Brand + mission  |  Sunday Worship card ---------------------------- */}
  <div
    class="mx-auto grid max-w-content items-start gap-l px-m pt-section-md pb-l md:grid-cols-2 md:gap-section-md"
  >
    {/* Brand + mission + Plan a Visit */}
    <div class="text-center md:text-left">
      <a
        href="/"
        aria-label={`${brandName} home`}
        class="inline-flex flex-col leading-none transition-opacity hover:opacity-80"
      >
        <span class="font-display text-2xl text-chapel-foreground">Second Presbyterian</span>
        <span class="mt-0.5 font-display text-lg text-chapel-foreground/70"
          >Church of the Angels, Chicago</span
        >
      </a>
      <p
        class="mx-auto mt-m max-w-[32rem] font-display text-lg leading-snug text-chapel-foreground/75 italic md:mx-0"
      >
        {mission}
      </p>
      <a
        href="/worship"
        class="press-tactile mt-m inline-flex items-center rounded-full bg-primary px-l py-2.5 text-xs font-semibold tracking-eyebrow text-primary-foreground uppercase transition-colors hover:bg-primary-dark"
      >
        Plan a Visit
      </a>
    </div>

    {/* Sunday Worship card — the church "when + where" at a glance. */}
    <div
      class="rounded-lg border border-chapel-foreground/15 bg-white/5 p-l text-center md:text-left"
    >
      <p class="text-xs tracking-eyebrow text-chapel-foreground/70 uppercase">Sunday Worship</p>
      <div class="mx-auto mt-s mb-m h-px w-12 bg-gold/60 md:mx-0" aria-hidden="true"></div>
      <p
        class="flex items-center justify-center gap-xs font-display text-lg text-chapel-foreground md:justify-start"
      >
        <Clock size={16} aria-hidden="true" className="shrink-0 text-gold" />
        {serviceTimes}, in person and online
      </p>
      <p
        class="mt-s flex items-start justify-center gap-xs text-chapel-foreground/80 md:justify-start"
      >
        <MapPin size={16} aria-hidden="true" className="mt-1 shrink-0 text-gold" />
        <span>{addressLine}<br />{cityStateZip}</span>
      </p>
      <a
        href={mapHref}
        target="_blank"
        rel="noopener noreferrer"
        class="link-underline mt-s inline-block text-sm font-semibold text-chapel-foreground transition-colors hover:text-white"
      >
        Get directions
      </a>
    </div>
  </div>

  {/* ---- Four-column link grid. Single centered column on mobile. ----------- */}
  <div
    class="mx-auto grid max-w-content grid-cols-1 gap-l border-t border-chapel-foreground/15 px-m pt-l pb-l text-center sm:grid-cols-2 sm:text-left lg:grid-cols-4"
  >
    {
      FOOTER_COLUMNS.map((col, i) => (
        <nav aria-labelledby={`footer-col-${i}`}>
          <p
            id={`footer-col-${i}`}
            class="mb-s text-xs tracking-eyebrow text-chapel-foreground/70 uppercase"
          >
            {col.title}
          </p>
          <ul class="list-none space-y-2 p-0 text-sm">
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  class={footerLink}
                  {...(l.external || /^https?:\/\//.test(l.href)
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {})}
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    {/* GET IN TOUCH — email, phone, office hours, socials. */}
    <div>
      <p class="mb-s text-xs tracking-eyebrow text-chapel-foreground/70 uppercase">Get in touch</p>
      <address class="space-y-2 text-sm not-italic">
        {
          email && (
            <p>
              <a
                href={`mailto:${email}`}
                class="inline-flex items-center gap-xs text-chapel-foreground/85 transition-colors hover:text-white"
              >
                <Mail size={14} aria-hidden="true" />
                {email}
              </a>
            </p>
          )
        }
        {
          phone && (
            <p>
              <a
                href={telHref(phone)}
                class="inline-flex items-center gap-xs text-chapel-foreground/85 transition-colors hover:text-white"
              >
                <Phone size={14} aria-hidden="true" />
                {phone}
              </a>
            </p>
          )
        }
        {officeHours && <p class="text-chapel-foreground/60">Office hours: {officeHours}</p>}
      </address>
      {
        (ig || fb || yt) && (
          <ul class="mt-m flex list-none justify-center gap-s p-0 text-sm sm:justify-start">
            {ig && (
              <li>
                <a
                  href={ig}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Instagram"
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-chapel-foreground/25 text-chapel-foreground transition-colors hover:border-white/40 hover:bg-white/10 hover:text-white"
                >
                  <IconBrandInstagram size={20} stroke={1.5} />
                </a>
              </li>
            )}
            {fb && (
              <li>
                <a
                  href={fb}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Facebook"
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-chapel-foreground/25 text-chapel-foreground transition-colors hover:border-white/40 hover:bg-white/10 hover:text-white"
                >
                  <IconBrandFacebook size={20} stroke={1.5} />
                </a>
              </li>
            )}
            {yt && (
              <li>
                <a
                  href={yt}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="YouTube"
                  class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-chapel-foreground/25 text-chapel-foreground transition-colors hover:border-white/40 hover:bg-white/10 hover:text-white"
                >
                  <IconBrandYoutube size={20} stroke={1.5} />
                </a>
              </li>
            )}
          </ul>
        )
      }
    </div>
  </div>

  {/* Thin bottom bar — copyright, privacy, optional credit. */}
  <div class="border-t border-chapel-foreground/15">
    <div
      class="mx-auto flex max-w-content flex-col items-center justify-center gap-xs px-m py-m text-center text-xs text-chapel-foreground/70 sm:flex-row sm:justify-between"
    >
      <p>© {currentYear} {brandName}</p>
      <div class="flex items-center gap-m">
        <a href={giveHref} class="link-underline transition-colors hover:text-white">Give</a>
        <a href="/privacy" class="underline underline-offset-2 transition-colors hover:text-white"
          >Privacy policy</a
        >
        {
          siteCredit &&
            (siteCreditUrl ? (
              <a
                href={siteCreditUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="underline underline-offset-2 transition-colors hover:text-white"
              >
                {siteCredit}
              </a>
            ) : (
              <span>{siteCredit}</span>
            ))
        }
      </div>
    </div>
  </div>
</footer>
