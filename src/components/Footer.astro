---
// Foundation, edit with care
// Site footer. Reads as a separate zone from the FinalCta section above it.
//
// Structure (top to bottom):
//   1. Bronze accent stripe (brand signature, matches header + mobile drawer)
//   2. Optional newsletter signup (only when siteSettings.newsletter.enabled)
//   3. Four-column church link grid: Visit / Get Involved / Connect / Get in touch
//   4. Text wordmark + tagline, centered
//   5. Thin bottom bar: auto-year copyright, privacy link, optional credit
//
// Contact details fall back to src/data/site.ts constants so the footer shows
// real information before Sanity siteSettings is wired.
//
// Tailwind v4 gotcha: max-w-xs/s/m/l are shadowed by this project's custom
// --spacing-* tokens. Use max-w-md / max-w-2xl / arbitrary values for text widths.

import { site } from '@/data/site';
import { IconBrandInstagram, IconBrandFacebook, IconBrandYoutube } from '@tabler/icons-react';
import { Phone, MapPin } from 'lucide-react';
import CopyEmailButton from '@/components/CopyEmailButton';
import NewsletterSignup from '@/components/NewsletterSignup';
import { telHref } from '@/lib/phone';

interface NewsletterConfig {
  enabled?: boolean;
  heading?: string;
  blurb?: string;
  buttonLabel?: string;
  successMessage?: string;
  consentNote?: string;
  formActionUrl?: string | null;
  audienceId?: string | null;
}

interface Props {
  siteSettings?: {
    title?: string;
    email?: string;
    phone?: string;
    socialInstagram?: string;
    socialFacebook?: string;
    socialYoutube?: string;
    tagline?: string;
    footerCredit?: string;
    footerCreditUrl?: string;
    newsletter?: NewsletterConfig | null;
  } | null;
}

const { siteSettings } = Astro.props as Props;

const brandName = siteSettings?.title ?? site.name;
const email = siteSettings?.email ?? site.contact.email;
const phone = siteSettings?.phone ?? site.contact.phone;
const ig = siteSettings?.socialInstagram ?? site.social.instagram;
const fb = siteSettings?.socialFacebook ?? site.social.facebook;
const yt = siteSettings?.socialYoutube ?? site.social.youtube;
const tagline = siteSettings?.tagline ?? 'Serving and celebrating Jesus for the good of the world.';

const currentYear = new Date().getFullYear();
const siteCredit = siteSettings?.footerCredit;
const siteCreditUrl = siteSettings?.footerCreditUrl;

// Footer navigation, grouped to mirror the header IA.
const VISIT_LINKS = [
  { label: 'Plan a Visit', href: '/worship' },
  { label: 'Watch Sermons', href: '/sermons' },
  { label: 'What We Believe', href: '/what-we-believe' },
  { label: 'Music', href: '/music' },
  { label: 'Events', href: '/events' },
];
const INVOLVED_LINKS = [
  { label: 'Grow', href: '/grow' },
  { label: 'Serve', href: '/serve' },
  { label: 'Kids', href: '/kids' },
  { label: 'Food Ministry', href: '/food' },
];
const CONNECT_LINKS = [
  { label: 'Pastors & Staff', href: '/pastor-staff' },
  { label: 'Use Our Space', href: '/use-our-space' },
  { label: 'Weddings', href: '/weddings' },
  { label: 'Give', href: '/give' },
];
---

<footer class="bg-muted text-foreground">
  {/* Brand accent stripe — matches header + mobile drawer. */}
  <div class="h-1 bg-primary" aria-hidden="true"></div>

  {/* Newsletter signup — renders only when siteSettings.newsletter.enabled. */}
  {siteSettings?.newsletter?.enabled && (
    <div class="mx-auto max-w-content px-m pt-l">
      <div class="max-w-md mx-auto">
        <NewsletterSignup
          client:visible
          newsletter={siteSettings.newsletter}
          source="footer"
        />
      </div>
    </div>
  )}

  {/* Four-column church link grid. Single centered column on mobile. */}
  <div class="mx-auto max-w-content px-m pt-l pb-m grid gap-l grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 text-center sm:text-left">
    <nav aria-labelledby="footer-visit">
      <p id="footer-visit" class="text-xs uppercase tracking-eyebrow text-foreground/80 mb-s">Visit</p>
      <ul class="text-sm space-y-2 list-none p-0">
        {VISIT_LINKS.map((l) => (
          <li><a href={l.href} class="link-underline inline-block text-foreground/85 hover:text-link transition-colors">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-involved">
      <p id="footer-involved" class="text-xs uppercase tracking-eyebrow text-foreground/80 mb-s">Get Involved</p>
      <ul class="text-sm space-y-2 list-none p-0">
        {INVOLVED_LINKS.map((l) => (
          <li><a href={l.href} class="link-underline inline-block text-foreground/85 hover:text-link transition-colors">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-connect">
      <p id="footer-connect" class="text-xs uppercase tracking-eyebrow text-foreground/80 mb-s">Connect</p>
      <ul class="text-sm space-y-2 list-none p-0">
        {CONNECT_LINKS.map((l) => (
          <li><a href={l.href} class="link-underline inline-block text-foreground/85 hover:text-link transition-colors">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    {/* GET IN TOUCH — address, email, phone, office hours, socials. */}
    <div>
      <p class="text-xs uppercase tracking-eyebrow text-foreground/80 mb-s">Get in touch</p>
      <address class="not-italic text-sm space-y-2">
        <p class="flex items-start justify-center sm:justify-start gap-xs text-foreground/85">
          <MapPin size={14} aria-hidden="true" className="mt-0.5 shrink-0" />
          <span>{site.contact.addressLine}<br />{site.contact.cityStateZip}</span>
        </p>
        {email && <p><CopyEmailButton client:visible email={email} variant="link" /></p>}
        {phone && (
          <p>
            <a href={telHref(phone)} class="inline-flex items-center gap-xs text-link hover:text-primary-dark transition-colors">
              <Phone size={14} aria-hidden="true" />
              {phone}
            </a>
          </p>
        )}
        <p class="text-foreground/70">Office hours: {site.contact.officeHours}</p>
      </address>
      {(ig || fb || yt) && (
        <ul class="mt-m flex justify-center sm:justify-start gap-s text-sm list-none p-0">
          {ig && (
            <li>
              <a href={ig} target="_blank" rel="noopener noreferrer" aria-label="Instagram"
                class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-foreground hover:bg-primary hover:border-primary hover:text-primary-foreground transition-colors">
                <IconBrandInstagram size={20} stroke={1.5} />
              </a>
            </li>
          )}
          {fb && (
            <li>
              <a href={fb} target="_blank" rel="noopener noreferrer" aria-label="Facebook"
                class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-foreground hover:bg-primary hover:border-primary hover:text-primary-foreground transition-colors">
                <IconBrandFacebook size={20} stroke={1.5} />
              </a>
            </li>
          )}
          {yt && (
            <li>
              <a href={yt} target="_blank" rel="noopener noreferrer" aria-label="YouTube"
                class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border text-foreground hover:bg-primary hover:border-primary hover:text-primary-foreground transition-colors">
                <IconBrandYoutube size={20} stroke={1.5} />
              </a>
            </li>
          )}
        </ul>
      )}
    </div>
  </div>

  {/* Text wordmark + tagline — centered brand signature. */}
  <div class="mx-auto max-w-content px-m pb-l flex flex-col items-center gap-xs text-center leading-none">
    <a href="/" aria-label={`${brandName} home`} class="inline-flex flex-col items-center hover:opacity-80 transition-opacity">
      <span class="font-display text-2xl text-foreground">Second Presbyterian</span>
      <span class="font-display text-lg text-foreground/70 mt-0.5">Church of Chicago</span>
    </a>
    {tagline && <p class="mt-s text-sm text-foreground/60 italic max-w-[30rem]">{tagline}</p>}
  </div>

  {/* Thin bottom bar — copyright, privacy, optional credit. */}
  <div class="border-t border-border">
    <div class="mx-auto max-w-content px-m py-m flex flex-col sm:flex-row items-center justify-center sm:justify-between gap-xs text-xs text-foreground/80 text-center">
      <p>© {currentYear} {brandName}</p>
      <div class="flex items-center gap-m">
        <a href="/privacy" class="underline underline-offset-2 hover:text-link transition-colors">Privacy policy</a>
        {siteCredit && (
          siteCreditUrl ? (
            <a href={siteCreditUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-link transition-colors">{siteCredit}</a>
          ) : (
            <span>{siteCredit}</span>
          )
        )}
      </div>
    </div>
  </div>
</footer>
