---
// Photo gallery block. Responsive grid of images with optional captions. Turns
// "a single photo" into a gallery with one editor control. Captions/headings
// inherit the SectionShell tone color.
import SanityImage from '@/components/SanityImage.astro';

const { block } = Astro.props as { block: any };
const images = (block?.images ?? []).filter((i: any) => i?.asset);
const COLS: Record<string, string> = {
  '2': 'grid-cols-2',
  '3': 'grid-cols-2 sm:grid-cols-3',
  '4': 'grid-cols-2 sm:grid-cols-3 lg:grid-cols-4',
};
const colClass = COLS[block?.columns ?? '3'] ?? COLS['3'];
---

{
  block && images.length > 0 && (
    // aria-label provides an accessible name for the gallery region so
    // screen readers identify it even when there is no visible heading.
    // When a heading is present it labels the region via aria-labelledby
    // (the heading id) instead.
    <div
      class="mx-auto max-w-content px-m"
      role="region"
      aria-label={block.heading ? undefined : (block.eyebrow ?? 'Photo gallery')}
      aria-labelledby={block.heading ? 'gallery-heading' : undefined}
    >
      {(block.eyebrow || block.heading || block.intro) && (
        <div class="mb-l max-w-2xl">
          {block.eyebrow && (
            <p class="text-xs tracking-eyebrow uppercase opacity-70">{block.eyebrow}</p>
          )}
          {block.heading && (
            <h2 id="gallery-heading" class="mt-s font-display text-h2">
              {block.heading}
            </h2>
          )}
          {block.intro && <p class="mt-s leading-relaxed opacity-80">{block.intro}</p>}
        </div>
      )}
      <div class={`grid ${colClass} gap-s sm:gap-m`} data-stagger-grid>
        {images.map((img: any) => (
          <figure>
            <div class="img-zoom group aspect-[4/3] overflow-hidden rounded-md ring-1 ring-border-soft">
              <SanityImage
                source={img}
                width={800}
                sizes="(min-width: 1024px) 30vw, 50vw"
                alt={img.alt || ''}
                class="h-full w-full object-cover"
              />
            </div>
            {img.caption && <figcaption class="mt-xs text-sm opacity-70">{img.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  )
}
