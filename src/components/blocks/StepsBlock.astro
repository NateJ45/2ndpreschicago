---
// Numbered steps ("plan a visit" 1-2-3). Tone-adaptive: text inherits the
// SectionShell color; the number badge uses the gold accent.
const { block } = Astro.props as { block: any };
const steps = block?.steps ?? [];
---

{
  block && steps.length > 0 && (
    <div class="mx-auto max-w-content px-m">
      {(block.eyebrow || block.heading || block.intro) && (
        <div class="mb-l max-w-2xl">
          {block.eyebrow && (
            <p class="text-xs tracking-eyebrow uppercase opacity-70">{block.eyebrow}</p>
          )}
          {block.heading && <h2 class="mt-s font-display text-h2">{block.heading}</h2>}
          {block.intro && <p class="mt-s leading-relaxed opacity-80">{block.intro}</p>}
        </div>
      )}
      <ol
        class="counter-reset grid list-none grid-cols-1 gap-l p-0 sm:grid-cols-2 lg:grid-cols-3"
        data-stagger-grid
      >
        {steps.map((s: any, i: number) => (
          <li class="flex gap-m">
            <span
              class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-gold/60 font-display text-h4 text-gold-ink"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <div>
              <h3 class="font-display text-h4">{s.title}</h3>
              {s.body && <p class="mt-xs leading-relaxed opacity-80">{s.body}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  )
}
