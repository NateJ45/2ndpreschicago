---
// Safe to edit by hand
// Home-page arched-frame hero slideshow. Renders 2+ images as a slow cross-fading
// slideshow with the same subtle Ken Burns zoom the full-bleed hero uses, reusing
// the global .hero-slideshow / .hero-slide CSS + the advance script pattern from
// HeroBackground.astro. Unlike HeroBackground there is NO darkening overlay: this
// sits inside the arched photo frame (a standalone image, not a backdrop for text),
// and the images are sized for the ~45vw frame rather than full-bleed.
//
// The container is position:absolute (inset:0) via .hero-slideshow, so the parent
// arched frame must be position:relative. The first slide is eager + carries the
// alt; the rest are lazy + decorative. Reduced-motion users get the first slide,
// static (the script bails and the CSS animation/transition is disabled).

import SanityImage from '@/components/SanityImage.astro';

interface SanityImageObject {
  asset?: { _ref?: string; _id?: string };
  alt?: string;
  hotspot?: { x: number; y: number; height: number; width: number };
  crop?: { top: number; bottom: number; left: number; right: number };
}

interface Props {
  images: SanityImageObject[];
}

const { images } = Astro.props as Props;
const slides = (images ?? []).filter((img) => !!img?.asset);
---

{slides.length >= 2 && (
  <div class="hero-slideshow" data-hero-slideshow>
    {slides.map((img, i) => (
      <SanityImage
        source={img}
        width={1000}
        sizes="(min-width: 768px) 45vw, 90vw"
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : 'low'}
        quality={72}
        alt={i === 0 ? (img.alt || 'Second Presbyterian Church of Chicago') : (img.alt || '')}
        class={`hero-slide${i === 0 ? ' is-active' : ''}`}
      />
    ))}
  </div>

  <script is:inline>
    (function () {
      function initHeroSlideshow() {
        // Tear down a timer from a previous page first; the tab + its document
        // listeners persist across Astro View Transitions, so re-wiring without
        // this would stack intervals on detached slides.
        if (window.__heroSlideshowTimer) {
          clearInterval(window.__heroSlideshowTimer);
          window.__heroSlideshowTimer = null;
        }
        var box = document.querySelector('[data-hero-slideshow]');
        if (!box) return;
        var slides = box.querySelectorAll('.hero-slide');
        if (slides.length < 2) return;
        var reduce = false;
        try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (_) {}
        if (reduce) return; // first slide stays visible, no motion

        var current = 0;
        var STEP_MS = 4500; // ~3s hold + 1.5s cross-fade
        window.__heroSlideshowTimer = setInterval(function () {
          if (document.hidden) return; // pause while the tab is hidden
          slides[current].classList.remove('is-active');
          current = (current + 1) % slides.length;
          slides[current].classList.add('is-active');
        }, STEP_MS);
      }
      initHeroSlideshow();
      if (!window.__heroSlideshowBound) {
        window.__heroSlideshowBound = true;
        document.addEventListener('astro:page-load', initHeroSlideshow);
      }
    })();
  </script>
)}
