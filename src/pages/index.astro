---
// Safe to edit by hand for copy + structure changes.
// Home page for Second Presbyterian Church of Chicago.
// Section order: hero (sanctuary photo) → welcome → Sunday worship →
// get involved → events teaser → food ministry → welcoming close.
//
// Content renders from these inline values today; once Sanity is wired the
// homePage singleton can drive the hero + section copy (see getHomePage()).

import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getHomePage, getSiteSettings } from '@/lib/queries';
import { site } from '@/data/site';
import SectionHeading from '@/components/SectionHeading.astro';
import FinalCta from '@/components/FinalCta.astro';
import heroSanctuary from '@/assets/hero-sanctuary.webp';

const [page, siteSettings] = await Promise.all([
  getHomePage().catch(() => null),
  getSiteSettings().catch(() => null),
]);

const title = page?.seoTitle ?? site.name;
const description =
  page?.seoDescription ??
  'A historic, welcoming Presbyterian church in Chicago\'s South Loop. Join us for worship Sundays at 11am. Whoever you are, you are welcome here.';

const youtube = site.social.youtube;

// Shared button classes (pill CTAs, matching the brand).
const pillPrimary =
  'press-tactile inline-flex items-center justify-center min-h-[44px] px-l py-s rounded-full text-xs font-semibold uppercase tracking-[0.18em] bg-primary text-primary-foreground hover:bg-primary-dark transition-colors';
const pillOnDark =
  'press-tactile inline-flex items-center justify-center min-h-[44px] px-l py-s rounded-full text-xs font-semibold uppercase tracking-[0.18em] border border-white/70 text-white hover:bg-white/10 hover:border-white transition-colors';
const pillOutline =
  'press-tactile inline-flex items-center justify-center min-h-[44px] px-l py-s rounded-full text-xs font-semibold uppercase tracking-[0.18em] border border-primary text-link hover:bg-accent transition-colors';

const ministries = [
  { title: 'Grow', href: '/grow', body: 'Walk with others on the Way of Jesus through Bible study and good conversation.' },
  { title: 'Serve', href: '/serve', body: 'Love our South Loop neighbors through hands-on, practical ministry.' },
  { title: 'Kids', href: '/kids', body: 'Children are part of the worshipping congregation, noise and needs and all.' },
  { title: 'Food', href: '/food', body: 'Free food for all in need, no questions asked, at our Cullerton door.' },
];
---

<BaseLayout {title} {description} {siteSettings}>
  {/* ------- 1. Hero (sanctuary photo) ------------------------------------- */}
  <section
    class="relative overflow-hidden bg-accent-dark text-bg flex flex-col justify-end min-h-[86svh]"
    aria-labelledby="hero-heading"
  >
    <Image
      src={heroSanctuary}
      alt="The historic stone sanctuary of Second Presbyterian Church on South Michigan Avenue"
      widths={[768, 1280, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover object-center"
    />
    {/* Scrim for headline legibility. */}
    <div
      class="absolute inset-0 bg-gradient-to-t from-accent-dark/90 via-accent-dark/45 to-accent-dark/25"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto w-full max-w-content px-m pb-section-lg pt-section-md">
      <div class="hero-entry-stagger max-w-3xl">
        <p class="text-xs uppercase tracking-eyebrow text-bg/85">The Church of the Angels · South Loop, Chicago</p>
        <div class="mt-xs mb-m h-px w-12 bg-bg/40" aria-hidden="true"></div>
        <h1 id="hero-heading" class="font-display text-h1 leading-headline-tight tracking-[-0.02em] text-bg">
          Serving and celebrating Jesus for the good of the world.
        </h1>
        <p class="mt-m max-w-2xl text-lg text-bg/90">
          We gather in the abundant life of Jesus to worship, love, serve, pray, and share the gospel
          in word and deed. Whoever you are, you are welcome here.
        </p>
        <div class="mt-l flex flex-wrap gap-s">
          <a href="/worship" class={pillPrimary}>Plan a Visit</a>
          <a href={youtube} target="_blank" rel="noopener noreferrer" class={pillOnDark}>Watch Online</a>
        </div>
      </div>
    </div>
  </section>

  {/* ------- 2. Welcome ----------------------------------------------------- */}
  <section class="bg-background" aria-labelledby="welcome-heading">
    <div data-reveal class="mx-auto max-w-content px-m py-section-lg grid grid-cols-1 md:grid-cols-[1.1fr_1fr] gap-l md:gap-section-md items-start">
      <SectionHeading
        eyebrow="Welcome"
        headline="The Church of the Angels in Chicago's South Loop"
        headingId="welcome-heading"
      />
      <div class="text-foreground/85 text-lg leading-relaxed space-y-m">
        <p>
          Second Presbyterian is a National Historic Landmark on Michigan Avenue, home to nine Tiffany
          windows and a sanctuary built for worship. The building is remarkable. The people are the point.
        </p>
        <p>
          We are a Reformed congregation in the Presbyterian Church (USA), and we welcome everyone:
          women and men, gay and straight, lifelong believers and the simply curious. Come as you are.
        </p>
        <div class="flex flex-wrap gap-s pt-xs">
          <a href="/what-we-believe" class={pillOutline}>What We Believe</a>
          <a href="/pastor-staff" class={pillOutline}>Meet Our Pastors</a>
        </div>
      </div>
    </div>
  </section>

  {/* ------- 3. Sunday worship --------------------------------------------- */}
  <section class="surface-warm bg-muted" aria-labelledby="worship-heading">
    <div data-reveal class="mx-auto max-w-content px-m py-section-lg">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-xs uppercase tracking-eyebrow text-foreground/80">Sunday Worship</p>
        <div class="mt-s mb-m h-px w-12 bg-primary/60 mx-auto" aria-hidden="true"></div>
        <h2 id="worship-heading" class="font-display text-h2 text-foreground">Join us at 11am</h2>
        <p class="mt-m text-lg text-foreground/85 leading-relaxed">
          Our service is traditional and liturgical, with hymns, spirituals, and anthems led by organ
          and choir. We share communion on the first Sunday of each month. Little ones are part of the
          worshipping congregation, and we welcome their noise and their needs.
        </p>
        <div class="mt-l flex flex-wrap justify-center gap-s">
          <a href="/worship" class={pillPrimary}>Plan a Visit</a>
          <a href={youtube} target="_blank" rel="noopener noreferrer" class={pillOutline}>Watch the Livestream</a>
        </div>
      </div>
    </div>
  </section>

  {/* ------- 4. Get involved ------------------------------------------------ */}
  <section class="bg-background" aria-labelledby="involved-heading">
    <div class="mx-auto max-w-content px-m py-section-lg">
      <SectionHeading
        eyebrow="Get Involved"
        headline="We are formed in community"
        subhead="Join us for worship, fellowship, study, art, and food. There is a place for you here."
        headingId="involved-heading"
        align="center"
        class="mx-auto"
      />
      <div class="mt-section-lg grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-m" data-stagger-grid>
        {ministries.map((m) => (
          <a
            href={m.href}
            class="card-lift group block rounded-md border border-border-soft bg-card p-l no-underline"
          >
            <h3 class="font-display text-h4 text-foreground group-hover:text-link transition-colors">{m.title}</h3>
            <p class="mt-s text-foreground/80 leading-relaxed">{m.body}</p>
            <span class="mt-m inline-flex items-center gap-xs text-xs uppercase tracking-eyebrow font-semibold text-link">
              Learn more <span aria-hidden="true">&rarr;</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ------- 5. Events teaser ----------------------------------------------- */}
  <section class="bg-muted" aria-labelledby="events-heading">
    <div data-reveal class="mx-auto max-w-content px-m py-section-lg grid grid-cols-1 md:grid-cols-[1fr_1.1fr] gap-l md:gap-section-md items-center">
      <SectionHeading
        eyebrow="What's On"
        headline="There is always something happening at Second"
        headingId="events-heading"
      />
      <div class="text-foreground/85 text-lg leading-relaxed space-y-s">
        <p>Worship, study, shared meals, music, and fellowship fill the week. A few of our weekly rhythms:</p>
        <ul class="space-y-2 list-none p-0 text-base">
          <li class="flex justify-between gap-m border-b border-border-soft pb-2"><span>Sunday Worship</span><span class="text-foreground/70">Sundays, 11am</span></li>
          <li class="flex justify-between gap-m border-b border-border-soft pb-2"><span>Lunch Bag</span><span class="text-foreground/70">Tue&ndash;Thu, 11am&ndash;1pm</span></li>
          <li class="flex justify-between gap-m border-b border-border-soft pb-2"><span>South Loop Community Table</span><span class="text-foreground/70">Sundays, 6:45pm</span></li>
          <li class="flex justify-between gap-m"><span>Mid-Morning Bible Study</span><span class="text-foreground/70">Thursdays, 10am</span></li>
        </ul>
        <div class="pt-s">
          <a href="/events" class={pillOutline}>See the Full Calendar</a>
        </div>
      </div>
    </div>
  </section>

  {/* ------- 6. Welcoming close --------------------------------------------- */}
  <FinalCta
    eyebrow="Come and See"
    headline="Whoever you are, you are welcome here."
    subhead="Plan your first visit, or simply show up on Sunday. We will be glad you came."
    cta={{ label: 'Plan a Visit', linkType: 'external', externalUrl: '/worship' }}
  />
</BaseLayout>
