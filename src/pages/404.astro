---
// Safe to edit by hand
// Custom 404. Warm, on-brand, two clear paths back. No search (there isn't one).
//
// Layout: two-column on desktop (text + photograph), stacked on mobile. The
// photo is sourced from Sanity and can be replaced with any studio photo.
// Asset is referenced by _ref so it pipes through the same SanityImage
// CDN/transform pipeline as every other photo on the site.

import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getNotFoundPage, getSiteSettings } from '@/lib/queries';
import SanityImage from '@/components/SanityImage.astro';
import notFoundPhoto from '@/assets/sanctuary-interior.webp';

const [notFoundPage, siteSettings] = await Promise.all([
  getNotFoundPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);

const seoTitle = notFoundPage?.seoTitle ?? 'Page not found';
const seoDescription =
  notFoundPage?.seoDescription ??
  'That page wandered off. Head back to the homepage or get in touch.';

const eyebrow = notFoundPage?.eyebrow ?? '404';
const headline = notFoundPage?.headline ?? 'That page wandered off.';
const body =
  notFoundPage?.body ??
  "It happens. Maybe a link is old, maybe the URL has a typo. Either way, here's where to head next.";

// Church CTAs (the template's "Browse the portfolio" / /portfolio is gone).
const primaryLabel = notFoundPage?.primaryCtaLabel ?? 'Back home';
const primaryHref = notFoundPage?.primaryCtaHref ?? '/';
const secondaryLabel = notFoundPage?.secondaryCtaLabel ?? 'Plan a visit';
const secondaryHref = notFoundPage?.secondaryCtaHref ?? '/worship';
const tertiaryLabel = notFoundPage?.tertiaryCtaLabel ?? 'Get in touch';
const tertiaryHref = notFoundPage?.tertiaryCtaHref ?? '/contact';

// Sanity image wins when set; otherwise a bundled sanctuary photo (no dead
// template asset _ref). Rendered in the site's signature arched frame.
const sanityPhoto = notFoundPage?.heroImage?.asset ? notFoundPage.heroImage : null;
const caption = notFoundPage?.heroImage?.caption ?? 'Second Presbyterian Church of Chicago';
---

<BaseLayout title={seoTitle} description={seoDescription} siteSettings={siteSettings} noindex>
  <section
    class="mx-auto grid max-w-content grid-cols-1 items-center gap-section-md px-m py-section-lg md:grid-cols-[1fr_1.1fr]"
    aria-labelledby="not-found-heading"
  >
    {
      /* Text column. Two clear paths back — no search (there isn't one).
        Centered on mobile so the lone-element page reads as a sympathetic
        "you're off-path" moment; left-aligned on desktop where the
        two-column layout needs the text anchored beside the photo column. */
    }
    <div class="text-center md:text-left">
      <p class="mb-s text-xs tracking-eyebrow text-foreground/80 uppercase">{eyebrow}</p>
      <h1
        id="not-found-heading"
        class="font-display text-h1 leading-headline-tight text-foreground"
      >
        {headline}
      </h1>
      <p class="mx-auto mt-m max-w-xl text-lg leading-relaxed text-foreground/80 md:mx-0">
        {body}
      </p>

      <div class="mt-l flex flex-wrap justify-center gap-m md:justify-start">
        <a
          href={primaryHref}
          class="press-tactile inline-flex items-center rounded-sm bg-primary-dark px-l py-s text-xs font-semibold tracking-eyebrow text-white uppercase hover:bg-accent-dark"
        >
          {primaryLabel}
        </a>
        <a
          href={secondaryHref}
          class="press-tactile inline-flex items-center rounded-sm border border-primary px-l py-s text-xs font-semibold tracking-eyebrow text-link uppercase hover:bg-accent"
        >
          {secondaryLabel}
        </a>
        <a
          href={tertiaryHref}
          class="press-tactile inline-flex items-center rounded-sm border border-border-soft px-l py-s text-xs font-semibold tracking-eyebrow text-foreground/85 uppercase hover:border-primary hover:text-primary-dark"
        >
          {tertiaryLabel}
        </a>
      </div>
    </div>

    {
      /* Photo column. Stacks above the text on mobile (md:order-2 swaps it on
        desktop so the eye lands on text first, photo balances right). */
    }
    <figure class="order-first md:order-2">
      <div
        class="aspect-[5/6] overflow-hidden arch-top shadow-sm ring-1 ring-primary/40 dark:ring-[#C7A875]/40"
      >
        {
          sanityPhoto ? (
            <SanityImage
              source={sanityPhoto}
              width={1000}
              sizes="(min-width: 768px) 50vw, 100vw"
              quality={75}
              alt={sanityPhoto.alt || 'Second Presbyterian Church of Chicago'}
              class="h-full w-full object-cover"
            />
          ) : (
            <Image
              src={notFoundPhoto}
              alt="Inside the sanctuary at Second Presbyterian, with its Tiffany windows"
              widths={[480, 768, 1000]}
              sizes="(min-width: 768px) 50vw, 100vw"
              class="h-full w-full object-cover"
            />
          )
        }
      </div>
      <figcaption class="mt-s text-right text-xs tracking-eyebrow text-foreground/80 uppercase">
        {caption}
      </figcaption>
    </figure>
  </section>
</BaseLayout>
