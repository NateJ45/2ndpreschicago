---
// Safe to edit by hand for copy + structure changes.
// Pastors & Staff. Full bios + headshots for the people who serve Second.
// Bios reproduced from the church's own staff pages; headshots pulled from the
// existing site (rights owned by the church).
// (When the church wants to edit these without code, this is the natural
// candidate for a Sanity "staffMember" collection later.)

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPageHero, getSiteSettings, getStaffMembers } from '@/lib/queries';
import heroStaff from '@/assets/hero-staff.webp';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { resolveSiteSettings } from '@/lib/siteSettings';
import { Image } from 'astro:assets';
import Hero from '@/components/Hero.astro';
import SanityImage from '@/components/SanityImage.astro';
import PortableTextStatic from '@/components/PortableTextStatic.astro';
import FinalCta from '@/components/FinalCta.astro';
import Sections from '@/components/Sections.astro';

import chesnaPhoto from '@/assets/chesna-hinkley.webp';
import judyPhoto from '@/assets/judy-landt.webp';
import michaelPhoto from '@/assets/michael-shawgo.webp';
import ashleyPhoto from '@/assets/ashley-mclean.webp';

const siteSettings = await getSiteSettings().catch(() => null);
const page = await getPageHero('staffPage').catch(() => null);

// Pastoral + office emails come from Sanity siteSettings via the resolver.
const settings = resolveSiteSettings(siteSettings);

// Staff render from the Sanity staffMember collection when present; otherwise
// the hardcoded bios below remain as the built-in fallback (so the page is
// never empty before an editor adds people in the Studio).
const sanityStaff = await getStaffMembers().catch(() => []);

const title = page?.seoTitle ?? `Pastors & Staff · ${site.name}`;
const description =
  page?.seoDescription ??
  'Meet the pastors and staff of Second Presbyterian Church of Chicago: Rev. Chesna Hinkley, Rev. Judy Landt, Michael Shawgo, and Ashley McLean.';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'Pastors & Staff', url: `${site.url}/pastor-staff` },
  ]),
];

const staff = [
  {
    name: 'Rev. Chesna Hinkley',
    role: 'Interim Pastor',
    email: settings.pastorEmail,
    photo: chesnaPhoto,
    bio: [
      `The Rev. Chesna Hinkley has been Interim Pastor at Second since the fall of 2024. She holds degrees from Princeton Theological Seminary and the University of Pittsburgh, where she concentrated in neuroscience, and she is pursuing a Doctor of Ministry in Reformed Theology at Pittsburgh Theological Seminary.`,
      `She was ordained in 2021 at Madison Avenue Presbyterian Church in New York City, where she led children's ministry, mission, adult education, and the young adult group. At work, her passions are people, preaching, and strategizing for the future.`,
      `Outside of ministry she loves literature, traveling (23 countries and 28 states so far), sharing meals with friends, and keeping company with her cat, Regan.`,
    ],
    favorites: [
      { label: 'Reading', items: 'The Divine Conspiracy by Dallas Willard, and When You Are Engulfed in Flames by David Sedaris' },
      { label: 'Watching', items: '30 Rock, Midnight Mass, and Ozark' },
      { label: 'Listening', items: 'The Ezra Klein Show, the Bible Project podcast, and Sufjan Stevens' },
    ],
  },
  {
    name: 'Rev. Judy Landt',
    role: 'Parish Associate',
    photo: judyPhoto,
    bio: [
      `The Rev. Judy Landt serves as Parish Associate at Second. She holds a Master of Divinity from McCormick Theological Seminary, BA and MAT degrees from the University of Chicago, and a JD from Illinois Institute of Technology Chicago-Kent College of Law.`,
      `She was ordained as a Minister of Word and Sacrament in the PCUSA in 2003, and has served churches in Illinois, Wisconsin, and Minnesota. She is also experienced as a mediator and conflict consultant for churches, families, businesses, and courts.`,
    ],
  },
  {
    name: 'Michael Shawgo',
    role: 'Director of Music & Organist',
    photo: michaelPhoto,
    bio: [
      `Michael Shawgo earned his Bachelor of Music in Organ Performance from Illinois Wesleyan University in Bloomington, studying under Dr. David Gehrenbeck. He has additionally studied with J. Marcus Ritchie at the Cathedral of St. Philip in Atlanta and with Dexter Bailey in Chicago.`,
      `He is a member of the American Guild of Organists, the Organ Historical Society, the American Theatre Organ Society, and Phi Mu Alpha.`,
    ],
    favorites: [
      { label: 'Reading', items: 'Grant Williams by Giancarlo Stampalia' },
      { label: 'Watching', items: 'Downton Abbey' },
      { label: 'Listening', items: '20s and 30s blues and jazz, and opera' },
    ],
  },
  {
    name: 'Ashley McLean',
    role: 'Office Administrator',
    email: settings.email,
    photo: ashleyPhoto,
    bio: [
      `Ashley McLean is the Office Administrator at Second. She has a background in communications, graphic arts, and office management.`,
      `Ashley likes making jewelry, experimenting with her 3D printer, and working on home improvement and decor projects around the house. She and her fiance have two dogs, James Brown (JB) and Bella, who is blind, and together they love to cook and try new recipes.`,
    ],
    favorites: [
      { label: 'Reading', items: "The Artist's Way by Julia Cameron, and women's health" },
      { label: 'Watching', items: 'documentaries and docuseries' },
      { label: 'Listening', items: '90s and 00s neo soul and R&B, and audiobooks' },
    ],
  },
];

// Normalize the Sanity collection and the hardcoded fallback into one render
// shape so the markup below stays single-source. Sanity bios are Portable Text
// blocks; fallback bios are plain strings. Favorites use {label, value}.
const useSanityStaff = Array.isArray(sanityStaff) && sanityStaff.length > 0;
const people = useSanityStaff
  ? sanityStaff.map((p: any) => ({
      name: p.name,
      role: p.role,
      email: p.email,
      sanityPhoto: p.photo?.asset ? p.photo : null,
      localPhoto: null as null,
      bioBlocks: p.bio,
      bioStrings: null as string[] | null,
      favorites: (p.favorites ?? []).map((f: any) => ({ label: f.label, value: f.value })),
    }))
  : staff.map((p) => ({
      name: p.name,
      role: p.role,
      email: (p as any).email as string | undefined,
      sanityPhoto: null,
      localPhoto: p.photo,
      bioBlocks: null,
      bioStrings: p.bio,
      favorites: ((p as any).favorites ?? []).map((f: any) => ({ label: f.label, value: f.items })),
    }));
---

<BaseLayout {title} {description} {schemas} {siteSettings}>
  <Hero
    eyebrow={page?.heroEyebrow ?? 'Pastors & Staff'}
    headline={page?.heroHeadline ?? "The people you'll meet at Second"}
    subhead={page?.heroSubhead ?? 'A small, dedicated team serving a historic congregation in the South Loop.'}
    keyword={page?.heroKeyword}
    backgroundImage={page?.heroImage ?? null}
    localImage={heroStaff}
    localImageAlt="The sanctuary of Second Presbyterian Church"
    headingId="staff-hero"
    size="short"
  />

  <section class="bg-background" aria-label="Pastors and staff">
    <div class="mx-auto max-w-content px-m py-section-lg space-y-section-md">
      {people.map((person) => (
        <article class="grid grid-cols-1 md:grid-cols-[1fr_2fr] gap-l md:gap-section-md items-start border-b border-border-soft pb-section-md last:border-b-0 last:pb-0">
          <div class="md:sticky md:top-28">
            {/* Arched headshot — carries the building's arch motif onto the staff. */}
            <div class="w-44 sm:w-52 aspect-[4/5] overflow-hidden arch-top-sm ring-1 ring-primary/40 dark:ring-[#C7A875]/40 bg-muted shadow-sm">
              {person.sanityPhoto ? (
                <SanityImage
                  source={person.sanityPhoto}
                  width={420}
                  sizes="(min-width: 640px) 208px, 176px"
                  alt={person.sanityPhoto.alt || `${person.name}, ${person.role} at Second Presbyterian Church`}
                  class="h-full w-full object-cover"
                />
              ) : (
                <Image
                  src={person.localPhoto}
                  alt={`${person.name}, ${person.role} at Second Presbyterian Church`}
                  widths={[176, 208, 352, 416]}
                  sizes="(min-width: 640px) 208px, 176px"
                  class="h-full w-full object-cover"
                />
              )}
            </div>
            <h2 class="mt-l font-display text-h3 text-foreground">{person.name}</h2>
            <p class="mt-xs text-xs uppercase tracking-eyebrow text-foreground/80">{person.role}</p>
            {person.email && (
              <a href={`mailto:${person.email}`} class="mt-s inline-block text-sm text-link underline underline-offset-2 hover:text-primary-dark transition-colors break-all">
                {person.email}
              </a>
            )}
          </div>
          <div class="text-foreground/85 text-lg leading-relaxed space-y-m">
            {person.bioBlocks ? (
              <PortableTextStatic value={person.bioBlocks} />
            ) : (
              person.bioStrings?.map((p) => <p>{p}</p>)
            )}
            {person.favorites && person.favorites.length > 0 && (
              <dl class="mt-l grid grid-cols-1 gap-y-1 border-t border-border-soft pt-m text-sm text-foreground/70">
                {person.favorites.map((f) => (
                  <div class="flex gap-2">
                    <dt class="w-20 shrink-0 font-semibold uppercase tracking-eyebrow text-xs pt-0.5 text-muted-foreground">{f.label}</dt>
                    <dd class="flex-1">{f.value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <Sections sections={page?.flexibleSections} fallbackEmail={settings.email} />

  <FinalCta
    eyebrow={page?.finalCtaEyebrow ?? "Come and See"}
    headline={page?.finalCtaHeadline ?? "We would love to meet you"}
    subhead={page?.finalCtaSubhead ?? "Join us for worship on Sunday, or reach out to the office any time."}
    cta={page?.finalCta?.label ? page.finalCta : { label: 'Plan a Visit', linkType: 'external', externalUrl: '/worship' }}
  />
</BaseLayout>
