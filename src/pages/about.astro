---
// Safe to edit by hand for copy + structure changes.
// About page. The church's story and its landmark building. Sanity-aware
// (aboutPage singleton drives the hero when present) with church fallbacks.

import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAboutPage, getSiteSettings } from '@/lib/queries';
import { breadcrumbSchema } from '@/lib/schemas';
import { site } from '@/data/site';
import { Image } from 'astro:assets';
import Hero from '@/components/Hero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import FinalCta from '@/components/FinalCta.astro';
import Sections from '@/components/Sections.astro';
import angelMurals from '@/assets/angel-murals.jpg';
import sanctuaryInterior from '@/assets/sanctuary-interior.webp';

const [page, siteSettings] = await Promise.all([
  getAboutPage().catch(() => null),
  getSiteSettings().catch(() => null),
]);

const title = page?.seoTitle ?? `About · ${site.name}`;
const description =
  page?.seoDescription ??
  'A National Historic Landmark and a living congregation in Chicago\'s South Loop. The story of Second Presbyterian Church, the Church of the Angels.';

const heroEyebrow = page?.heroEyebrow ?? 'About Second';
const heroHeadline = page?.heroHeadline ?? 'A landmark church with an open door';
const heroSubhead =
  page?.heroSubhead ??
  'Known as the Church of the Angels, Second Presbyterian has worshipped on Michigan Avenue for generations. The building is extraordinary. The people are the point.';

const schemas = [
  breadcrumbSchema([
    { name: 'Home', url: site.url },
    { name: 'About', url: `${site.url}/about` },
  ]),
];

const pillOutline =
  'press-tactile inline-flex items-center justify-center min-h-[44px] px-l py-s rounded-full text-xs font-semibold uppercase tracking-[0.18em] border border-primary text-link hover:bg-accent transition-colors';
---

<BaseLayout {title} {description} {schemas} {siteSettings}>
  <Hero
    eyebrow={heroEyebrow}
    headline={heroHeadline}
    subhead={heroSubhead}
    backgroundImage={page?.heroImage ?? null}
    localImage={angelMurals}
    localImageAlt="The painted angels on the sanctuary ceiling at Second Presbyterian"
    headingId="about-hero"
    size="short"
  />

  {/* Feature: the angel murals (the church's namesake) */}
  <figure class="mx-auto max-w-content px-m pt-section-lg">
    <Image
      src={angelMurals}
      alt="The painted choir of angels on the sanctuary ceiling that gives the church its nickname"
      widths={[768, 1280, 1500]}
      sizes="(min-width: 1280px) 1216px, 100vw"
      class="w-full h-auto rounded-md shadow-sm"
    />
    <figcaption class="mt-s text-sm text-foreground/70 italic text-center">
      {page?.muralCaption ?? 'The painted angels of the sanctuary, the namesake of the Church of the Angels.'}
    </figcaption>
  </figure>

  {/* The building */}
  <section class="bg-background" aria-labelledby="about-building">
    <div class="mx-auto max-w-content px-m py-section-lg grid grid-cols-1 md:grid-cols-2 gap-l md:gap-section-md items-center">
      <div>
        <SectionHeading
          eyebrow={page?.buildingEyebrow ?? 'A National Historic Landmark'}
          headline={page?.buildingHeadline ?? 'The Church of the Angels'}
          headingId="about-building"
        />
        <div class="mt-l text-foreground/85 text-lg leading-relaxed space-y-m">
          <p>
            {page?.buildingBodyP1 ??
              'Our sanctuary, rebuilt in 1901 in the Arts and Crafts style after fire, is home to nine Tiffany windows and a ceiling of painted angels that gave the church its nickname. Visitors travel from all over the world to see it.'}
          </p>
          <p>
            {page?.buildingBodyP2 ??
              'It is one of the great interiors in American church architecture, and it is still, first and last, a room built for worship.'}
          </p>
          <div class="pt-xs">
            <a href="/use-our-space" class={pillOutline}>Visit or Use the Space</a>
          </div>
        </div>
      </div>
      <Image
        src={sanctuaryInterior}
        alt="The nave of Second Presbyterian, lined with Tiffany windows beneath the Arts and Crafts ceiling"
        widths={[600, 900, 1197]}
        sizes="(min-width: 768px) 45vw, 100vw"
        class="w-full h-auto rounded-md shadow-sm"
      />
    </div>
  </section>

  {/* Who we are */}
  <section class="surface-warm bg-muted" aria-labelledby="about-who">
    <div class="mx-auto max-w-content px-m py-section-lg grid grid-cols-1 md:grid-cols-2 gap-l md:gap-section-md items-start">
      <SectionHeading
        eyebrow={page?.whoEyebrow ?? 'Who we are'}
        headline={page?.whoHeadline ?? 'A living congregation in the South Loop'}
        headingId="about-who"
      />
      <div class="text-foreground/85 text-lg leading-relaxed space-y-m">
        <p>
          {page?.whoBodyP1 ??
            'We are a Reformed congregation in the Presbyterian Church (USA), gathering each week to worship, love, serve, pray, and share the gospel in word and deed.'}
        </p>
        <p>
          {page?.whoBodyP2 ??
            'We welcome everyone: women and men, gay and straight, lifelong believers and the simply curious. Whoever you are, you are welcome here.'}
        </p>
        <div class="flex flex-wrap gap-s pt-xs">
          <a href="/what-we-believe" class={pillOutline}>What We Believe</a>
          <a href="/pastor-staff" class={pillOutline}>Meet Our Pastors</a>
        </div>
      </div>
    </div>
  </section>

  <Sections sections={page?.flexibleSections} fallbackEmail={site.contact.email} />

  <FinalCta
    eyebrow={page?.finalCtaEyebrow ?? "Come and See"}
    headline={page?.finalCtaHeadline ?? "There is room for you here"}
    subhead={page?.finalCtaSubhead ?? "Join us for worship Sundays at 11am, and see the Church of the Angels for yourself."}
    cta={page?.finalCta?.label ? page.finalCta : { label: 'Plan a Visit', linkType: 'external', externalUrl: '/worship' }}
    backgroundImage={page?.finalCtaBackgroundImage}
  />
</BaseLayout>
