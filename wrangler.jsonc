{
  // Cloudflare Workers configuration for this project.
  // Cloudflare merged Pages into Workers in early 2026; Workers is the path forward.
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "2ndpreschicago",
  "main": "@astrojs/cloudflare/entrypoints/server",
  // Sessions: @astrojs/cloudflare declares a KV binding named SESSION even
  // when the site does not use sessions. Left unpinned, wrangler tries to
  // auto-provision "2ndpreschicago-session" on every deploy and fails with
  // error 10014 (a namespace with this title already exists), because an
  // earlier run already created it. Pinning the id of the namespace that
  // exists is the fix; reid and mas both hit this first.
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "d1b8ec4cf23540c685bbc4791456e409",
    },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
